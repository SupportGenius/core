# Trim the `COPY . .` build context in bin/supportgenius/Dockerfile. The
# builder only needs the source tree, the lockfile and rust-toolchain.toml;
# everything here is local build state that would bloat the context or, for
# target/ and *.db, silently leak host state into the image build.

# Rust build output (workspace root and any nested crate target dirs).
target/
**/target/

# Version-control and CI metadata.
.git/
.gitignore
.github/

# `worker-build` output: regenerated by `worker-build --release`, never
# committed (mirrors .gitignore's `**/build/`).
**/build/

# Wrangler local state (local D1 sqlite, caches) and Node tooling.
.wrangler/
node_modules/

# Local SQLite state: the binary's default database and any scratch
# copies of it, plus WAL/SHM sidecars.
*.db
*.db-shm
*.db-wal

# Local scratch and editor noise.
*.log
*.swp
.DS_Store
