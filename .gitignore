# Rust build output.
/target

# `worker-build` output: `wrangler.toml`'s `main` points at
# `build/worker/shim.mjs` inside each venture; it is regenerated by
# `worker-build --release` and never committed.
**/build/

# Wrangler local state (`.wrangler/` holds the local D1 sqlite, caches).
.wrangler/

# Node tooling (wrangler installs via npx).
node_modules/
